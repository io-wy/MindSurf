# =============================================================================
# GPU-optimized production image (CUDA 12.4)
# =============================================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS builder

WORKDIR /app

# Install build tools required by native Python dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install uv and a relocatable Python runtime
COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR="/opt/uv/python"
RUN uv python install 3.12

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Linux dependencies are locked to the CUDA 12.4 PyTorch index in pyproject.toml.
RUN uv sync --python 3.12 --no-dev --frozen --no-install-project

# =============================================================================
# Runtime stage
# =============================================================================
FROM nvidia/cuda:12.4.1-runtime-ubuntu22.04 AS runtime

WORKDIR /app

# Install runtime libraries
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Copy uv, the managed Python runtime, and the virtual environment
COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /usr/local/bin/uv
COPY --from=builder /opt/uv/python /opt/uv/python
COPY --from=builder /app/.venv /app/.venv

ENV UV_PYTHON_INSTALL_DIR="/opt/uv/python"
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONPATH="/app/src"
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV NVIDIA_VISIBLE_DEVICES=all
ENV CUDA_MODULE_LOADING=LAZY

# Copy application code
COPY src/ ./src/
COPY scripts/ ./scripts/
COPY configs/ ./configs/
COPY alembic/ ./alembic/
COPY alembic.ini ./

EXPOSE 8000

CMD ["uvicorn", "python_starter.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
